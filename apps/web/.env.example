# Before You Sign — web app environment template.
# Copy to .env.local and fill in real values. NEVER commit .env / .env.local.
# Per repo convention, model names and keys come from the environment, never hardcoded.
#
# The LLM is used in Wave 3 ONLY for document extraction (text -> schema). It never
# advises and never computes a financial figure. All numbers come from the
# deterministic engine in lib/engine/.

# --- LLM provider (Wave 3: document extraction) ---
# Provider: "openai" | "ollama"
LLM_PROVIDER=openai
# Model name (read from env — do not hardcode in code)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# For a local/free option during development:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- App ---
NEXT_PUBLIC_APP_NAME=Before You Sign

# --- Payments (F6: paid full report) ---
# Stripe TEST-mode secret key. Without it, checkout is cleanly disabled and the
# UI shows "payments not configured" (no fake success). Get a free key at
# https://dashboard.stripe.com/test/apikeys — it starts with sk_test_.
# Test card once set: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=

# --- Demo unlock (show the paid full report without a payment) ---
# Set DEMO_UNLOCK=1 to let the "Unlock" button reveal the full/paid report
# WITHOUT taking a payment, clearly labelled as a demo. Intended for the public
# demo deployment that has no Stripe key. Leave unset (or =0) in any deployment
# that takes real payments. Ignored whenever STRIPE_SECRET_KEY is set.
DEMO_UNLOCK=0
